# Writes ps5c/build_info.h (git commit, build number, dirty flag, build date) at every build;
# the header only changes (and triggers recompiles) when those do.
# Inputs: SRC (source dir), OUT (header path).
execute_process(COMMAND git rev-parse --short=7 HEAD WORKING_DIRECTORY ${SRC}
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR commit STREQUAL "")
    set(commit "unknown")
endif()
# the build number: commits so far (grows with every commit; updates compare it)
execute_process(COMMAND git rev-list --count HEAD WORKING_DIRECTORY ${SRC}
                OUTPUT_VARIABLE build OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR build STREQUAL "")
    set(build 0)
endif()
set(source_archive FALSE)
if(commit STREQUAL "unknown" AND EXISTS "${SRC}/SOURCE-VERSION.txt")
    set(source_archive TRUE)
    file(STRINGS "${SRC}/SOURCE-VERSION.txt" release_info)
    foreach(line ${release_info})
        if(line MATCHES "^commit=([0-9a-f]+)$")
            string(SUBSTRING "${CMAKE_MATCH_1}" 0 7 commit)
        elseif(line MATCHES "^build=([0-9]+)$")
            set(build "${CMAKE_MATCH_1}")
        endif()
    endforeach()
endif()
# tracked files only: game dumps and user data are ignored anyway
execute_process(COMMAND git diff --quiet HEAD -- src include frontends cmake CMakeLists.txt WORKING_DIRECTORY ${SRC}
                RESULT_VARIABLE dirty ERROR_QUIET)
if(dirty EQUAL 0 OR source_archive)
    set(dirty 0)
else()
    set(dirty 1)
endif()
string(TIMESTAMP date "%Y-%m-%d" UTC)
if(EXISTS "${SRC}/LOCAL-REVIEW.txt")
    set(dirty 1)
endif()
set(text "/* generated by cmake/build_info.cmake */
#ifndef PS5C_BUILD_INFO_H
#define PS5C_BUILD_INFO_H
#define PS5C_GIT_COMMIT \"${commit}\"
#define PS5C_BUILD_NUMBER ${build}
#define PS5C_GIT_DIRTY ${dirty}
#define PS5C_BUILD_DATE \"${date}\"
#endif
")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()

# ps5c/shader_cache_version.h: hash of the shader translator's sources. The
# persistent shader cache (vk_shader_cache.c) starts over when it changes.
file(GLOB translator ${SRC}/src/gpu/shader/*.c ${SRC}/src/gpu/shader/*.h)
list(APPEND translator ${SRC}/src/gpu/rdna2_decode.c ${SRC}/src/gpu/rdna2.h ${SRC}/src/gpu/rdna2_ops.inc)
list(SORT translator)
set(all "")
foreach(f ${translator})
    file(SHA256 ${f} h)
    string(APPEND all ${h})
endforeach()
string(SHA256 all "${all}")
string(SUBSTRING ${all} 0 16 all)
get_filename_component(dir ${OUT} DIRECTORY)
set(vout ${dir}/shader_cache_version.h)
set(text "/* generated by cmake/build_info.cmake */
#ifndef PS5C_SHADER_CACHE_VERSION_H
#define PS5C_SHADER_CACHE_VERSION_H
#define PS5C_SHADER_TRANSLATOR_HASH 0x${all}ull
#endif
")
set(old "")
if(EXISTS ${vout})
    file(READ ${vout} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${vout} "${text}")
endif()
